payment options.</li><li><strong>No Complex Forms:</strong> You don't need to fill out any compliance paperwork online. We will sort out all the details together during our initial phone call or first session.</li></ul>","text_color":"#3E5A66","typography_typography":"custom","typography_font_family":"Figtree","typography_font_size":{"unit":"px","size":16},"typography_line_height":{"unit":"em","size":1.7},"_css_classes":"jm-modal-text"},"elements":[]}]}]},{"id":"91fff63","elType":"container","isInner":false,"settings":{"content_width":"full","flex_direction":"column","flex_gap":{"row":"0","column":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"css_classes":"jm-modal jm-pop-dva-fees","_element_id":"jm-pop-dva-fees"},"elements":[{"id":"4826ff5","elType":"container","isInner":false,"settings":{"content_width":"full","flex_direction":"column","flex_gap":{"row":"14","column":"14","isLinked":true,"unit":"px","size":14},"padding":{"unit":"px","top":"40","right":"36","bottom":"36","left":"36","isLinked":false},"css_classes":"jm-modal-panel","padding_mobile":{"unit":"px","top":"32","right":"22","bottom":"26","left":"22","isLinked":false},"background_background":"classic","background_color":"#F7F5EF","border_radius":{"unit":"px","top":"24","right":"24","bottom":"24","left":"24","isLinked":true}},"elements":[{"id":"2f0cc60","elType":"widget","widgetType":"html","settings":{"html":"<button type=\"button\" class=\"jm-modal-close\" aria-label=\"Close\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></button>"},"elements":[]},{"id":"5b5f78c","elType":"widget","widgetType":"heading","settings":{"title":"DVA (Department of Veterans' Affairs)","header_size":"h2","title_color":"#12323F","typography_typography":"custom","typography_font_family":"Cormorant Garamond","typog